{
  "name": "@rwaimport/registry",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "description": "Verified, source-backed metadata for tokenized real-world assets.",
  "main": "./dist/registry.json",
  "files": [
    "dist",
    "schemas",
    "README.md",
    "ATTRIBUTION.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/registry.json",
    "./registry.json": "./dist/registry.json",
    "./manifest.json": "./dist/manifest.json",
    "./completeness.json": "./dist/completeness.json",
    "./deployment-policies.json": "./dist/deployment-policies.json",
    "./resolver-policies.json": "./dist/resolver-policies.json",
    "./indexes/*": "./dist/indexes/*.json",
    "./assets/*": "./dist/assets/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "node --import tsx scripts/build-index.ts",
    "check": "npm run typecheck && npm run validate && npm test && npm run build",
    "check:links": "node --import tsx scripts/check-links.ts",
    "check:source-drift": "node --import tsx scripts/check-source-drift.ts",
    "import:ondo-stocks": "node --import tsx scripts/import-ondo-stocks.ts",
    "import:robinhood-stocks": "node --import tsx scripts/import-robinhood-stocks.ts",
    "import:institutional-funds": "node --import tsx scripts/import-institutional-funds.ts",
    "import:diversification-batch": "node --import tsx scripts/import-diversification-batch.ts",
    "build:underlyings": "node --import tsx scripts/build-underlyings.ts",
    "enrich:underlyings:sec": "node --import tsx scripts/enrich-underlyings-sec.ts",
    "check:underlyings:sec": "node --import tsx scripts/enrich-underlyings-sec.ts --check",
    "migrate:reliability": "node --import tsx scripts/migrate-reliability-fields.ts",
    "sync:deployment-policies": "node --import tsx scripts/sync-deployment-policies.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx scripts/validate.ts",
    "verify:onchain": "node --import tsx scripts/verify-onchain.ts",
    "verify:onchain:write": "node --import tsx scripts/verify-onchain.ts --write"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "~5.0.3"
  }
}
