{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.org/schemas/valuation.schema.json",
  "title": "RWAImport valuation and corporate-action metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "quoteCurrency", "valuationType", "verifiedBy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "quoteCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "valuationType": { "enum": ["market-price", "reference-price", "nav", "oracle-price", "fixed", "unknown"] },
    "priceSourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "navSourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
        "chain": { "$ref": "#/$defs/id" },
        "address": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "updateFrequency": { "type": "string", "minLength": 1, "maxLength": 100 },
    "corporateActionModel": { "enum": ["scaled-ui-multiplier", "rebase", "accumulating-price", "manual", "none", "unknown"] },
    "distributionTreatment": { "enum": ["cash", "reinvested", "token-rebase", "multiplier-adjusted", "none", "unknown"] },
    "reserveReportingUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "verifiedBy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
  }
}
