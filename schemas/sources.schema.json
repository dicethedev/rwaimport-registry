{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.org/schemas/sources.schema.json",
  "title": "RWAImport evidence sources",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "title", "url", "publisher", "accessedAt", "retrievedAt", "lastVerifiedAt", "reviewAfter", "sourceVersion", "confidence"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "type": { "enum": ["issuer", "regulatory-filing", "chain-explorer", "documentation", "audit", "other"] },
      "title": { "type": "string", "minLength": 1, "maxLength": 300 },
      "url": { "type": "string", "format": "uri", "pattern": "^https://" },
      "publisher": { "type": "string", "minLength": 1, "maxLength": 200 },
      "accessedAt": { "type": "string", "format": "date" },
      "retrievedAt": { "type": "string", "format": "date-time" },
      "lastVerifiedAt": { "type": "string", "format": "date" },
      "reviewAfter": { "type": "string", "format": "date" },
      "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
      "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
      "confidence": { "enum": ["high", "medium", "low"] },
      "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
  }
}
