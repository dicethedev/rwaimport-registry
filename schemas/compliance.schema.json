{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.org/schemas/compliance.schema.json",
  "title": "RWAImport published compliance requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "permissioned", "kycRequired", "identityRequired", "transferRestricted", "dataAvailability", "verifiedBy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "permissioned": { "$ref": "#/$defs/answer" },
    "kycRequired": { "$ref": "#/$defs/answer" },
    "identityRequired": { "$ref": "#/$defs/answer" },
    "transferRestricted": { "$ref": "#/$defs/answer" },
    "transferEnforcement": { "enum": ["none", "legal-only", "onchain", "mixed", "unknown"] },
    "primaryMarket": { "$ref": "#/$defs/marketAccess" },
    "secondaryMarket": { "$ref": "#/$defs/marketAccess" },
    "eligibleInvestorTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["retail", "accredited", "qualified-purchaser", "institutional", "professional", "unknown"] }
    },
    "eligibleJurisdictions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "prohibitedJurisdictions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "minimumSubscription": { "$ref": "#/$defs/money" },
    "minimumRedemption": { "$ref": "#/$defs/money" },
    "lockupPeriod": { "type": "string", "minLength": 1, "maxLength": 200 },
    "dataAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumSubscription", "minimumRedemption", "lockupPeriod"],
      "properties": {
        "minimumSubscription": { "$ref": "#/$defs/availability" },
        "minimumRedemption": { "$ref": "#/$defs/availability" },
        "lockupPeriod": { "$ref": "#/$defs/availability" }
      }
    },
    "offeringDocuments": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "notes": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "verifiedBy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "answer": { "enum": ["yes", "no", "unknown"] },
    "availability": { "enum": ["known", "unknown", "not-applicable"] },
    "marketAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "kycRequired", "kybRequired"],
      "properties": {
        "access": { "enum": ["permissionless", "issuer-onboarding", "authorized-participants-only", "restricted", "unknown"] },
        "kycRequired": { "$ref": "#/$defs/answer" },
        "kybRequired": { "$ref": "#/$defs/answer" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
  }
}
