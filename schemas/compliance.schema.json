{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.org/schemas/compliance.schema.json",
  "title": "RWAImport published compliance requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "permissioned", "kycRequired", "identityRequired", "transferRestricted", "verifiedBy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "permissioned": { "$ref": "#/$defs/answer" },
    "kycRequired": { "$ref": "#/$defs/answer" },
    "identityRequired": { "$ref": "#/$defs/answer" },
    "transferRestricted": { "$ref": "#/$defs/answer" },
    "eligibleInvestorTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["retail", "accredited", "qualified-purchaser", "institutional", "professional", "unknown"] }
    },
    "eligibleJurisdictions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "notes": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "verifiedBy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "answer": { "enum": ["yes", "no", "unknown"] },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
  }
}
