{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.org/schemas/deployments.schema.json",
  "title": "RWAImport asset deployments",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["chain", "address", "standardIds", "status", "verification", "verifiedBy"],
    "properties": {
      "chain": { "$ref": "#/$defs/id" },
      "chainId": { "type": "integer", "minimum": 1 },
      "address": { "type": "string", "minLength": 1, "maxLength": 300 },
      "assetNamespace": { "type": "string", "pattern": "^[-a-z0-9]{1,32}$" },
      "assetReference": { "type": "string", "minLength": 1, "maxLength": 300 },
      "deploymentType": { "enum": ["issuer-native", "bridged", "wrapped", "synthetic", "unknown"] },
      "standardIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/id" }
      },
      "decimals": { "type": "integer", "minimum": 0, "maximum": 255 },
      "status": { "enum": ["active", "inactive", "deprecated"] },
      "proxyAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
      "implementationAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
      "deployedAt": { "type": "string", "format": "date" },
      "deploymentTransaction": { "type": "string", "minLength": 1, "maxLength": 200 },
      "deploymentBlock": { "type": "integer", "minimum": 0 },
      "standardEvidence": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standardId", "method"],
          "properties": {
            "standardId": { "$ref": "#/$defs/id" },
            "method": { "enum": ["onchain-interface", "issuer-documentation", "source-code", "manual-review"] },
            "sourceId": { "$ref": "#/$defs/id" }
          }
        }
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lastVerifiedAt", "accountExists", "method", "explorerVerified", "dataAvailability"],
        "properties": {
          "lastVerifiedAt": { "type": "string", "format": "date-time" },
          "accountExists": { "type": "boolean" },
          "method": { "enum": ["evm-bytecode", "solana-account-owner", "stellar-horizon", "aptos-api", "explorer", "manual"] },
          "runtimeCodeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "accountDataSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "owner": { "type": "string", "minLength": 1, "maxLength": 200 },
          "implementationAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "contractAdmin": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
          "explorerVerified": { "enum": ["yes", "no", "unknown"] },
          "observedName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "observedSymbol": { "type": "string", "minLength": 1, "maxLength": 32 },
          "observedDecimals": { "type": "integer", "minimum": 0, "maximum": 255 },
          "dataAvailability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deploymentTransaction", "deploymentBlock", "proxyImplementation", "contractAdmin", "explorerVerification", "observedName", "observedSymbol", "observedDecimals"],
            "properties": {
              "deploymentTransaction": { "$ref": "#/$defs/availability" },
              "deploymentBlock": { "$ref": "#/$defs/availability" },
              "proxyImplementation": { "$ref": "#/$defs/availability" },
              "contractAdmin": { "$ref": "#/$defs/availability" },
              "explorerVerification": { "$ref": "#/$defs/availability" },
              "observedName": { "$ref": "#/$defs/availability" },
              "observedSymbol": { "$ref": "#/$defs/availability" },
              "observedDecimals": { "$ref": "#/$defs/availability" }
            }
          }
        }
      },
      "verifiedBy": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/id" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "availability": { "enum": ["known", "unknown", "not-applicable"] }
  }
}
