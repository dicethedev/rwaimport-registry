{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.xyz/schemas/organization.schema.json",
  "title": "RWAImport organization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "status", "website", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "legalName": { "type": "string", "minLength": 1, "maxLength": 300 },
    "jurisdiction": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "status": { "enum": ["active", "inactive"] },
    "website": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "accessedAt"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "accessedAt": { "type": "string", "format": "date" },
          "lastVerifiedAt": { "type": "string", "format": "date" },
          "reviewAfter": { "type": "string", "format": "date" },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
  }
}
