{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.org/schemas/asset.schema.json",
  "title": "RWAImport asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "symbol", "underlyingId", "instrumentType", "denominationCurrency", "organizationRoles", "assetClass", "issuerId", "status", "marketDataLinks", "verifiedBy"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "symbol": { "type": "string", "minLength": 1, "maxLength": 32 },
    "underlyingId": { "$ref": "#/$defs/id" },
    "instrumentType": {
      "enum": ["security-backed-token", "debt-security", "fund-share", "bearer-note", "certificate", "synthetic-exposure", "spv-interest", "vault-share", "other", "unknown"]
    },
    "denominationCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "legalStructure": { "type": "string", "minLength": 1, "maxLength": 500 },
    "securityType": { "type": "string", "minLength": 1, "maxLength": 200 },
    "shareClass": { "type": "string", "minLength": 1, "maxLength": 100 },
    "underlyingRights": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "redemptionRights": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "offeringType": { "type": "string", "minLength": 1, "maxLength": 200 },
    "regulatoryExemption": { "type": "string", "minLength": 1, "maxLength": 300 },
    "prospectusUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "organizationRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organizationId", "roles"],
        "properties": {
          "organizationId": { "$ref": "#/$defs/id" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["issuer", "asset-manager", "tokenization-provider", "transfer-agent", "custodian", "fund-administrator", "auditor", "oracle-provider", "broker-dealer", "authorized-participant", "other"]
            }
          }
        }
      }
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "value"],
        "properties": {
          "scheme": { "enum": ["isin", "issuer-id"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "assetClass": {
      "enum": ["treasury", "money-market", "private-credit", "public-equity", "exchange-traded-fund", "real-estate", "commodity", "stablecoin", "other"]
    },
    "issuerId": { "$ref": "#/$defs/id" },
    "tokenizationProviderIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "status": { "enum": ["announced", "active", "inactive"] },
    "website": { "type": "string", "format": "uri", "pattern": "^https://" },
    "marketDataLinks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "type", "url", "description"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 100 },
          "type": { "enum": ["issuer", "aggregator", "price-api", "chain-explorer"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "verifiedBy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
  }
}
