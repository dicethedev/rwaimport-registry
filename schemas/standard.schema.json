{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.org/schemas/standard.schema.json",
  "title": "RWAImport token standard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "category", "capabilities", "status", "referenceUrl"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "category": {
      "enum": [
        "fungible-token",
        "non-fungible-token",
        "semi-fungible-token",
        "multi-token",
        "permissioned-token",
        "restricted-token",
        "security-token",
        "bond-token",
        "tokenized-vault",
        "rwa-interface",
        "identity-registry",
        "other"
      ]
    },
    "specificationType": { "enum": ["erc", "solana-program", "industry-framework"] },
    "maintainer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 50 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "relatedStandardIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "status": { "enum": ["draft", "review", "last-call", "final", "active", "stagnant", "withdrawn", "deprecated"] },
    "referenceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
  }
}
