{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.org/schemas/underlying.schema.json",
  "title": "RWAImport underlying instrument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "ticker", "type", "status", "sourceAssetIds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 300 },
    "ticker": { "type": "string", "minLength": 1, "maxLength": 32 },
    "type": {
      "enum": ["equity", "exchange-traded-fund", "treasury", "money-market-fund", "bond", "commodity", "private-credit", "real-estate", "cash", "other"]
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "value"],
        "properties": {
          "scheme": { "enum": ["isin", "cusip", "figi", "lei", "issuer-id"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "exchange": { "type": "string", "minLength": 1, "maxLength": 100 },
    "jurisdiction": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "status": { "enum": ["active", "inactive"] },
    "sourceAssetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 }
  }
}
