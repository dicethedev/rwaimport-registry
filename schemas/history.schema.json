{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwaimport.org/schemas/history.schema.json",
  "title": "RWAImport product change history",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "effectiveAt", "recordedAt", "summary", "sourceIds"],
    "properties": {
      "id": { "$ref": "#/$defs/id" },
      "type": { "enum": ["contract-migration", "proxy-upgrade", "symbol-change", "deployment-status-change", "legal-terms-change", "jurisdiction-change", "relationship-change", "other"] },
      "effectiveAt": { "type": "string", "format": "date-time" },
      "recordedAt": { "type": "string", "format": "date-time" },
      "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
      "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
      "previousValue": {},
      "newValue": {}
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100 }
  }
}
